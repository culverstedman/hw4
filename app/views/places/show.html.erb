<h1><%= @place["name"] %></h1>

<p><a href="/places">Back to Places I've Been</a></p>

<div class="row">
  <% for entry in @entries %>
    <div class="col-lg-4 col-md-6 col-12 mb-3">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title"><%= entry["title"] %></h5>
          <p class="card-text"><%= entry["description"] %></p>
          <p class="card-text"><small class="text-muted"><%= entry["occurred_on"] %></small></p>
        </div>
      </div>
    </div>
  <% end %>
</div>

<% if @current_user %>
  <a href="/entries/new?place_id=<%= @place["id"] %>" class="btn btn-primary">Log a new entry for <%= @place["name"] %></a>
<% end %>